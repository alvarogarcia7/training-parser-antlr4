# Copy to .env and adjust for your deployment
# .env is gitignored — do not commit it

# Docker image name and tag
APP_IMAGE=onorca

# Host port to bind to (the container always listens on 80)
APP_PORT=8080

# Host interface to bind to (0.0.0.0 = all interfaces, 127.0.0.1 = loopback only)
# When a reverse proxy handles ONORCA.DEV → localhost:APP_PORT, use 127.0.0.1
APP_HOST=127.0.0.1
