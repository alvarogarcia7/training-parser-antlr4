# Copy to .env and adjust for your deployment:  cp .env.example .env
# .env is gitignored — do not commit it. Docker Compose reads it automatically.

# Compose project name. Namespaces containers, networks and volumes so this
# stack cannot collide with other stacks running on the same Docker host.
COMPOSE_PROJECT_NAME=onorca

# Docker image name and tag
APP_IMAGE=onorca
APP_TAG=latest

# Host interface to bind to.
#   127.0.0.1 = loopback only (default; put a reverse proxy in front for ONORCA.DEV)
#   0.0.0.0   = all interfaces
APP_HOST=127.0.0.1

# Host port to bind to (the container always listens on 80).
# Pick a port that no other service on this Docker host uses.
APP_PORT=8080

# Resource limits for the container
APP_MEM_LIMIT=256m
