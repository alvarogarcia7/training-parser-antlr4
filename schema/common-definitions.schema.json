{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/common-definitions.json",
  "title": "Common Definitions for Workout Schemas",
  "description": "Shared type definitions used across different workout schema formats",
  "$defs": {
    "workoutMetadata": {
      "type": "object",
      "required": ["workout_id", "date"],
      "properties": {
        "workout_id": {
          "type": "string",
          "description": "Unique workout identifier"
        },
        "type": {
          "type": "string",
          "description": "Workout type identifier"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "location": {
          "type": "string",
          "description": "Workout location or gym name"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "bpm": {
      "type": "object",
      "description": "Heart rate statistics in beats per minute",
      "properties": {
        "average": {
          "type": "integer",
          "minimum": 0,
          "maximum": 220,
          "description": "Average heart rate"
        },
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 220,
          "description": "Minimum heart rate"
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 220,
          "description": "Maximum heart rate"
        }
      }
    },
    "kcal": {
      "type": "object",
      "description": "Calorie expenditure",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total calories burned"
        },
        "active": {
          "type": "integer",
          "minimum": 0,
          "description": "Active calories burned (excludes resting expenditure)"
        }
      }
    },
    "statsEntry": {
      "type": "object",
      "description": "Statistics reported by a single device or source for one session",
      "properties": {
        "source": {
          "type": "string",
          "description": "Device or app that reported these stats (e.g., apple watch, polar)"
        },
        "duration": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}:\\d{2}$",
          "description": "Session duration in HH:MM:SS format"
        },
        "bpm": {
          "$ref": "#/$defs/bpm"
        },
        "kcal": {
          "$ref": "#/$defs/kcal"
        },
        "fat_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of calories burned from fat"
        },
        "zone_minutes": {
          "type": "integer",
          "minimum": 0,
          "description": "Minutes spent in the target heart-rate zone"
        },
        "cardio_load": {
          "type": "integer",
          "minimum": 0,
          "description": "Device-reported cardio load for the session"
        }
      }
    },
    "statistics": {
      "type": "object",
      "description": "Workout statistics and metrics",
      "properties": {
        "tracker": {
          "type": "string",
          "description": "Device or app used to track workout (e.g., Apple Watch, Garmin)"
        },
        "duration": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}:\\d{2}$",
          "description": "Workout duration in HH:MM:SS format"
        },
        "bpm": {
          "$ref": "#/$defs/bpm"
        },
        "kcal": {
          "$ref": "#/$defs/kcal"
        },
        "entries": {
          "type": "array",
          "description": "Per-source statistics; allows multiple trackers (e.g. apple watch and polar) for one session",
          "items": {
            "$ref": "#/$defs/statsEntry"
          }
        }
      }
    },
    "equipment": {
      "type": "string",
      "enum": ["smith machine","barbell", "dumbbell", "machine", "bodyweight", "cable", "kettlebell", "other"]
    },
    "weightUnit": {
      "type": "string",
      "enum": ["kg", "lb"]
    },
    "set": {
      "type": "object",
      "required": ["reps"],
      "properties": {
        "reps": {
          "type": "integer",
          "minimum": 0
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "description": "Load used (omit for bodyweight-only sets)"
        },
        "unit": {
          "$ref": "#/$defs/weightUnit"
        },
        "rpe": {
          "type": "number",
          "minimum": 1,
          "maximum": 10,
          "description": "Rate of Perceived Exertion"
        },
        "rir": {
          "type": "integer",
          "minimum": 0,
          "description": "Reps in Reserve"
        },
        "tempo": {
          "type": "string",
          "pattern": "^[0-9X]{3,4}$",
          "description": "E.g. 31X1"
        },
        "rest_sec": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    }
  }
}
