{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/season_report.schema.json",
  "title": "Training Season Report",
  "description": "Schema for the season detection report produced by scripts/detect_seasons.py (SeasonReport.to_dict())",
  "type": "object",
  "required": ["config", "seasons", "ignored"],
  "properties": {
    "config": {
      "type": "object",
      "description": "Season detection configuration used to produce this report",
      "required": ["min_break_days", "min_sessions", "max_reps_for_1rm"],
      "properties": {
        "min_break_days": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum days without training that starts a new season"
        },
        "min_sessions": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum number of training days for a group to count as a season"
        },
        "max_reps_for_1rm": {
          "type": "integer",
          "minimum": 1,
          "description": "Sets with at most this many repetitions are preferred for the 1RM estimate"
        }
      },
      "additionalProperties": false
    },
    "seasons": {
      "type": "array",
      "description": "Detected seasons with at least min_sessions training days",
      "items": { "$ref": "#/definitions/season" }
    },
    "ignored": {
      "type": "array",
      "description": "Groups of training days shorter than min_sessions, not counted as seasons",
      "items": { "$ref": "#/definitions/season" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "season": {
      "type": "object",
      "required": [
        "start",
        "end",
        "sessions",
        "duration_days",
        "longest_break_days",
        "break_before_days",
        "exercises"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date of the first session of the season"
        },
        "end": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date of the last session of the season"
        },
        "sessions": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of training days in the season"
        },
        "duration_days": {
          "type": "integer",
          "minimum": 1,
          "description": "Calendar days from start to end, inclusive"
        },
        "longest_break_days": {
          "type": "integer",
          "minimum": 0,
          "description": "Longest run of days without training inside the season"
        },
        "break_before_days": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Days without training before this season started (null for the first group)"
        },
        "exercises": {
          "type": "array",
          "items": { "$ref": "#/definitions/exercise" }
        }
      },
      "additionalProperties": false
    },
    "exercise": {
      "type": "object",
      "required": ["exercise", "unit", "one_rep_max", "best_set", "average_percentage_1rm", "sets"],
      "properties": {
        "exercise": {
          "type": "string",
          "minLength": 1,
          "description": "Exercise name"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "description": "Weight unit (e.g. kg, lb)"
        },
        "one_rep_max": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated one-rep max (Brzycki formula)"
        },
        "best_set": { "$ref": "#/definitions/set" },
        "average_percentage_1rm": {
          "type": "number",
          "minimum": 0,
          "description": "Mean %1RM over all sets of the season"
        },
        "sets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/set" }
        }
      },
      "additionalProperties": false
    },
    "set": {
      "type": "object",
      "required": ["date", "repetitions", "weight", "percentage_1rm"],
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date the set was performed"
        },
        "repetitions": {
          "type": "integer",
          "minimum": 0
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "percentage_1rm": {
          "type": "number",
          "minimum": 0,
          "description": "Set weight expressed as a percentage of the season 1RM"
        }
      },
      "additionalProperties": false
    }
  }
}
